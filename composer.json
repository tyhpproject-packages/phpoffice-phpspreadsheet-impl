{
    "name": "tyhpdef/phpoffice-phpspreadsheet-impl",
    "description": "Implementation package for tyhpdef/phpoffice-phpspreadsheet. Require tyhpdef/phpoffice-phpspreadsheet, not this package.",
    "keywords": [
        "dev",
        "static analysis",
        "internal"
    ],
    "type": "library",
    "license": "Apache-2.0",
    "version": "5.9.0.0",
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "tyhp": {
            "interopContractVersion": 1,
            "php-version": ">=8.2",
            "require": {
                "tyhpdef/php": "@dev",
                "tyhpdef/psr-simple-cache": "@dev",
                "tyhpdef/php-ext-dom": "@dev",
                "tyhpdef/php-ext-zip": "@dev",
                "tyhpdef/php-ext-simplexml": "@dev",
                "tyhpdef/php-ext-xmlwriter": "@dev",
                "tyhpdef/php-ext-gd": "@dev",
                "tyhpdef/maennchen-zipstream-php": "@dev",
                "tyhpdef/psr-http-message": "@dev"
            },
            "package": {
                "include": [
                    "./_tyhpdef/*.tyhpdef",
                    "./_tyhpdef/extensions/*.tyhpdef"
                ],
                "overlay": [
                    "./_tyhpdef/overlays/stubs/*.tyhpdef",
                    "./_tyhpdef/overlays/*.tyhpdef"
                ]
            },
            "public": "tyhpdef/phpoffice-phpspreadsheet"
        }
    },
    "require": {
        "php": ">=8.2",
        "phpoffice/phpspreadsheet": "5.9.0"
    },
    "require-dev": {
        "tyhpdef/php": "@dev",
        "tyhpdef/psr-simple-cache": "@dev",
        "tyhpdef/php-ext-dom": "@dev",
        "tyhpdef/php-ext-zip": "@dev",
        "tyhpdef/php-ext-simplexml": "@dev",
        "tyhpdef/php-ext-xmlwriter": "@dev",
        "tyhpdef/php-ext-gd": "@dev",
        "tyhpdef/maennchen-zipstream-php": "@dev",
        "tyhpdef/psr-http-message": "@dev"
    }
}
